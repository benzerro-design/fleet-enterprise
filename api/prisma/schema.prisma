/// Dosar operațional — orchestrator flux tichet → programare → WO → deviz → cost.
model ServiceCase {
  id                     String                  @id @default(cuid())
  tenantId               String
  clientId               String
  vehicleId              String?
  workflowType           ServiceCaseWorkflowType
  serviceTypeId          String?
  sourceType             ServiceCaseSourceType
  sourceTicketId         String?                 @unique
  sourceTicket           CrmTicket?              @relation(fields: [sourceTicketId], references: [id], onDelete: SetNull)
  sourceReminderActionId String?
  currentStage           ServiceCaseStage        @default(intake)
  status                 ServiceCaseStatus       @default(active)
  supplierId             String?
  title                  String
  notes                  String?
  awaitingPostApproval   Boolean                 @default(false)
  postApprovalPath       PostApprovalPath?
  closedAt               DateTime?
  /// Vehicul mobil / imobil — din tichet sau patch daună.
  vehicleMovable               VehicleMovableState?
  /// Data evenimentului de daună (accident / constatare).
  damageEventOn                DateTime?                 @db.Date
  /// Tip asigurare daună (RCA / CASCO).
  damageInsuranceType          DamageInsuranceType?
  damageClaimNumber            String?
  damageInsurerName            String?
  /// FK catalog asigurători (opțional; name/email denormalizate pe dosar).
  damageInsurerId              String?
  damageClaimStatus            DamageClaimStatus?
  damageInsurerAgreedAt        DateTime?
  damageInsurerAgreedByUserId  String?
  damageInsurerAgreementNotes  String?
  /// Plătitor daună: asigurător vs client (client = skip pipeline asigurător).
  damagePayerType              DamagePayerType?
  /// Pipeline dosar asigurător (doar când payer = insurer).
  damageInsurerPipelineStatus  DamageInsurerPipelineStatus?
  /// Documente daună: array { id, kind, label?, notes?, received, uploadedAt, uploadedByLabel? }
  damageDocumentsJson          Json?
  /// Foto daună: array { id, url, kind, caption?, uploadedAt, uploadedByUserId?, uploadedByLabel? }
  damagePhotosJson             Json?
  /// Lock-uri secțiuni complete: Record<sectionKey, { lockedByUserId, lockedByLabel?, lockedAt }>
  damageSectionLocksJson       Json?
  /// Franciză CASCO (bani) — plătită de client; în cenți RON.
  damageCascoFranchiseCents    Int?
  /// Email asigurător (text liber până la modulul asigurători).
  damageInsurerEmail           String?
  /// Origine deviz față de asigurător: întocmit de noi | primit de la ei.
  damageQuoteOrigin            DamageQuoteOrigin?
  /// PDF deviz de la asigurător (sau copie locală încărcată).
  damageInsurerQuotePdfUrl     String?
  /// Log corespondență asigurător: array { id, at, direction, to, subject, status, quoteId?, note?, pdfUrl? }
  damageInsurerMailLogJson     Json?
  /// Constatare: pe poze vs inspector la partener.
  damageInspectionMode              DamageInspectionMode?
  /// PDF notă de constatare (emisă doar de asigurător).
  damageInspectionNotePdfUrl        String?
  damageInspectionNoteFileName      String?
  damageInspectionNoteIssuedOn      DateTime? @db.Date
  damageInspectionNoteReceivedAt    DateTime?
  damageInspectionNoteNotes         String?
  /// Istoric note de constatare (1..n, inclusiv după reconstatări).
  damageInspectionNotesJson         Json?
  /// Accept plată de la asigurător (document PDF) — câmpuri curente (ultimul).
  damagePaymentAcceptancePdfUrl     String?
  damagePaymentAcceptanceFileName   String?
  damagePaymentAcceptanceReceivedAt DateTime?
  damagePaymentAcceptanceNotes      String?
  /// Istoric Accept plată: array { id, sequence, pdfUrl, fileName?, receivedAt, notes? }.
  damagePaymentAcceptancesJson      Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client                 Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle                Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  supplier               Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  damageInsurer          Insurer?                @relation(fields: [damageInsurerId], references: [id], onDelete: SetNull)
  serviceType            TenantServiceType?      @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  workOrders             MaintenanceWorkOrder[]
  appointments           ServiceAppointment[]
  mobilityAssignments    MobilityAssignment[]
  roadsideInterventions  RoadsideIntervention[]

  @@index([tenantId])
  @@index([clientId])
  @@index([vehicleId])
  @@index([sourceTicketId])
  @@index([serviceTypeId])
  @@index([damageInsurerId])
  @@index([tenantId, status])
  @@index([tenantId, currentStage])
}

