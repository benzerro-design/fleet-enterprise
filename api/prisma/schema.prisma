enum MobilityDeliveryMode {
  customer_pickup
  delivered_to_customer
  at_supplier
}

/// Alocare mașină la schimb legată de WO (mobilitate client).
model MobilityAssignment {
  id                        String                   @id @default(cuid())
  tenantId                  String
  displayNumber             String?
  workOrderId               String
  serviceCaseId             String
  sourceTicketId            String?
  clientId                  String
  coveredVehicleId          String
  coveredVehicleRegSnapshot String?
  supplierId                String?
  replacementRegistration   String?
  status                    MobilityAssignmentStatus @default(draft)
  eligibilityHours          Int?
  eligibilityTriggeredAt    DateTime?
  handoverAt                DateTime?
  expectedReturnAt          DateTime?
  returnedAt                DateTime?
  deliveryMode              MobilityDeliveryMode?
  handoverUserLabel         String?
  waivedReason              String?
  notes                     String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  tenant                    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder                 MaintenanceWorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  serviceCase               ServiceCase              @relation(fields: [serviceCaseId], references: [id], onDelete: Cascade)
  sourceTicket              CrmTicket?               @relation(fields: [sourceTicketId], references: [id], onDelete: SetNull)
  client                    Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  coveredVehicle            Vehicle                  @relation("MobilityCoveredVehicle", fields: [coveredVehicleId], references: [id], onDelete: Restrict)
  supplier                  Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([tenantId, displayNumber])
  @@index([tenantId])
  @@index([workOrderId])
  @@index([serviceCaseId])
  @@index([sourceTicketId])
  @@index([tenantId, status])
  @@index([coveredVehicleId])
}

