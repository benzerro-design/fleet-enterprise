}

/// Intervenție asistență rutieră (ex. tractare) pe dosar — nu e WO separat.
model RoadsideIntervention {
  id              String                       @id @default(cuid())
  tenantId        String
  displayNumber   String?
  serviceCaseId   String
  sourceTicketId  String?
  workOrderId     String?
  clientId        String
  vehicleId       String?
  supplierId      String?
  kind            RoadsideInterventionKind
  status          RoadsideInterventionStatus   @default(draft)
  locationText    String?
  requestedAt     DateTime?
  dispatchedAt    DateTime?
  onSiteAt        DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  tenant          Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceCase     ServiceCase                  @relation(fields: [serviceCaseId], references: [id], onDelete: Cascade)
  sourceTicket    CrmTicket?                   @relation(fields: [sourceTicketId], references: [id], onDelete: SetNull)
  workOrder       MaintenanceWorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  client          Client                       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle         Vehicle?                     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  supplier        Supplier?                    @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([tenantId, displayNumber])
  @@index([tenantId])
  @@index([serviceCaseId])
  @@index([sourceTicketId])
  @@index([workOrderId])
  @@index([tenantId, status])
}
