  rejected
}

enum QuotePartsOrderStatus {
  none
  ordered
  in_stock
  delivered
}

enum WorkOrderWarrantyStatus {
  draft
  active
  locked
}

/// Deviz structurat pe comandă service (versiuni).
model WorkOrderQuote {
  id               String               @id @default(cuid())
  tenantId         String
  workOrderId      String
  version          Int                  @default(1)
  status           WorkOrderQuoteStatus @default(draft)
  currency         String               @default("RON")
  totalNetCents    Int                  @default(0)
  totalVatCents    Int                  @default(0)
  approvedNetCents Int?
  approvedVatCents Int?
  submittedAt      DateTime?
  approvedAt       DateTime?
  approvedByUserId String?
  rejectedAt       DateTime?
  rejectionReason  String?
  notes            String?
  costEntryId      String?              @unique
  invoicedAt       DateTime?
  invoiceNumber    String?
  invoiceDate      DateTime?
  invoiceAttachmentUrl String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder        MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  costEntry        CostEntry?           @relation(fields: [costEntryId], references: [id], onDelete: SetNull)
  lines            WorkOrderQuoteLine[]

  @@unique([workOrderId, version])
  @@index([tenantId])
  @@index([workOrderId])
  @@index([workOrderId, status])
}

/// Linie deviz (piese, manoperă).
model WorkOrderQuoteLine {
  id             String                 @id @default(cuid())
  tenantId       String
  quoteId        String
  sortOrder      Int                    @default(0)
  lineType       WorkOrderQuoteLineType @default(parts)
  approvalStatus WorkOrderQuoteLineApproval @default(pending)
  description    String
  quantity       Float                  @default(1)
  unitNetCents   Int
  vatRatePercent Int                    @default(19)
  partNumber     String?
  partCodeExempt Boolean                @default(false)
  partsOrderStatus QuotePartsOrderStatus @default(none)
  partsExpectedOn DateTime?
  warrantyMonths Int?
  warrantyKm     Int?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote          WorkOrderQuote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  warrantyLines  WorkOrderWarrantyLine[]

  @@index([tenantId])
  @@index([quoteId])
}

model WorkOrderWarranty {
  id               String                  @id @default(cuid())
  tenantId         String
  workOrderId      String                  @unique
  sourceQuoteId    String?
  status           WorkOrderWarrantyStatus @default(draft)
  startsAt         DateTime?
  startsKm         Int?
  conditionsPdfUrl String?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder        MaintenanceWorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  lines            WorkOrderWarrantyLine[]

  @@index([tenantId])
  @@index([workOrderId])
}

model WorkOrderWarrantyLine {
  id                String                 @id @default(cuid())
  tenantId          String
  warrantyId        String
  sortOrder         Int                    @default(0)
  sourceQuoteLineId String?
  lineType          WorkOrderQuoteLineType
  description       String
  partNumber        String?
  warrantyMonths    Int
  warrantyKm        Int?
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warranty          WorkOrderWarranty      @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  sourceQuoteLine   WorkOrderQuoteLine?    @relation(fields: [sourceQuoteLineId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([warrantyId])
  @@index([sourceQuoteLineId])
}

enum MobilityAssignmentStatus {
