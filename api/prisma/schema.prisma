generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  auditLogs          AuditLog[]
  costEntries        CostEntry[]
  maintenanceEntries MaintenanceEntry[]
  memberships        TenantMembership[]
  trips              Trip[]
  tripSheetDocuments TripSheetDocument[]
  vehicles           Vehicle[]
  clients            Client[]
  reminderActions    ReminderAction[]
  maintenancePlanItems MaintenancePlanItem[]
}

enum ClientStatus {
  active
  inactive
}

/// Organizație client (contractual) — înlocuiește `clientId` liber pe vehicul.
model Client {
  id        String       @id @default(cuid())
  tenantId  String
  code      String
  legalName String
  taxId     String?
  status    ClientStatus @default(active)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String
  displayName      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  auditLogsAsActor AuditLog[]         @relation("AuditActor")
  memberships      TenantMembership[]
  vehiclesCreated  Vehicle[]          @relation("VehicleCreatedBy")
  vehiclesUpdated  Vehicle[]          @relation("VehicleUpdatedBy")
  odometerReadings OdometerReading[]  @relation("OdometerReadingBy")
}

model TenantMembership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole @default(tenant_admin)
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Vehicle {
  id                 String             @id @default(cuid())
  tenantId           String
  clientId           String
  client             Client             @relation(fields: [clientId], references: [id])
  registrationNumber String
  type               VehicleType
  brand              String?
  model              String?
  vin                String?
  status             VehicleStatus      @default(active)
  odometerKm         Int                @default(0)
  itpExpiresOn       DateTime?
  itpStationName     String?
  itpReminderOffsetsDays     Json?
  itpReminderMenuSyncEnabled Boolean            @default(true)
  /** Serie CIV (legată de rubrica X din talon). */
  civSeries          String?
  civIssuedOn        DateTime?
  civRarOffice       String?
  /** Rubrici tehnice CIV (pag. 1–3) — chei aliniate la vehicle-civ-fields. */
  civProfile         Json?
  /** Pagina 4 — Mențiuni CIV. */
  civMentions        String?
  civImportedFromDocumentId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdByUserId    String?
  updatedByUserId    String?
  costEntries        CostEntry[]
  maintenanceEntries MaintenanceEntry[]
  trips              Trip[]
  createdBy          User?              @relation("VehicleCreatedBy", fields: [createdByUserId], references: [id])
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy          User?              @relation("VehicleUpdatedBy", fields: [updatedByUserId], references: [id])
  documents          VehicleDocument[]
  reminderActions    ReminderAction[]
  itpProfileReminder ReminderAction?    @relation("VehicleItpProfileReminder")
  odometerReadings   OdometerReading[]
  maintenancePlanItems MaintenancePlanItem[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

enum TripPurpose {
  business
  personal
  mixed
}

enum TripRoadType {
  urban
  extra_urban
  highway
  mixed
}

/// Trasee / curse (MVP — extins pentru FAZ-lite).
model Trip {
  id               String         @id @default(cuid())
  tenantId         String
  vehicleId        String
  reference        String?
  startedAt        DateTime       @default(now())
  endedAt          DateTime?
  originLabel      String?
  destLabel        String?
  distanceKm       Int?
  purpose          TripPurpose?
  roadType         TripRoadType?
  odometerStartKm  Int?
  odometerEndKm    Int?
  /// Conducător (text liber până la modulul Client).
  driverName       String?
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vehicleId])
}

enum TripSheetDocType {
  trip_sheet
  faz_monthly
}

/// Document generat: foaie de parcurs sau FAZ lunar (arhivă PDF).
model TripSheetDocument {
  id              String           @id @default(cuid())
  tenantId        String
  docType         TripSheetDocType
  periodStart     DateTime
  periodEnd       DateTime
  vehicleIds      String[]
  driverName      String?
  clientIdFilter  String?
  title           String
  summaryJson     Json
  /// Legacy inline storage; null when `pdfStorageKey` is set (GCS).
  pdfData         Bytes?
  pdfStorageKey   String?
  pdfByteSize     Int?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// Mentenanță planificată sau înregistrată (MVP).
model MaintenanceEntry {
  id                   String    @id @default(cuid())
  tenantId             String
  vehicleId            String
  title                String
  performedAt          DateTime?
  odometerKm           Int?
  notes                String?
  costCents            Int?
  /// * Criteriu alocare costuri (cod predefinit: revizie, reparatie_mecanica, …).
  costAllocationCode   String?
  invoiceNumber        String?
  invoiceDate          DateTime?
  invoiceAttachmentUrl String?
  provider             String?
  /** Termen / dată următoare acțiune (ex. ITP valabil până la). */
  nextDueOn            DateTime?
  reminderOffsetsDays  Json?
  dueOdometerKm        Int?
  reminderOffsetsKm    Json?
  /** Dacă false, acțiunea nu apare în meniul Remindere până la reactivare din sursă. */
  reminderMenuSyncEnabled Boolean @default(true)
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle              Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reminderAction       ReminderAction?

  @@index([tenantId])
  @@index([vehicleId])
}

/// Costuri alocate vehiculului (MVP).
model CostEntry {
  id                   String    @id @default(cuid())
  tenantId             String
  vehicleId            String
  category             String
  amountCents          Int
  /** Litri alimentați — relevant pentru categoria Combustibil. */
  fuelLiters           Float?
  incurredOn           DateTime  @default(now())
  notes                String?
  odometerKm           Int?
  invoiceNumber        String?
  invoiceDate          DateTime?
  invoiceAttachmentUrl String?
  provider             String?
  /** Termen / dată următoare (ex. ITP valabil până la). */
  nextDueOn            DateTime?
  reminderOffsetsDays  Json?
  dueOdometerKm        Int?
  reminderOffsetsKm    Json?
  /** Dacă false, acțiunea nu apare în meniul Remindere până la reactivare din sursă. */
  reminderMenuSyncEnabled Boolean @default(true)
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle              Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reminderAction       ReminderAction?

  @@index([tenantId])
  @@index([vehicleId])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  meta        Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

model VehicleDocument {
  id                  String    @id @default(cuid())
  vehicleId           String
  documentTypeCode    String
  title               String
  expiresOn           DateTime?
  fileUrl             String?
  fileName            String?
  /** Zile înainte de expirare când se activează remindere (ex. [60, 30, 7, 1, 0]). */
  reminderOffsetsDays Json?
  dueOdometerKm       Int?
  reminderOffsetsKm   Json?
  /** Dacă false, acțiunea nu apare în meniul Remindere până la reactivare din sursă. */
  reminderMenuSyncEnabled Boolean @default(true)
  createdAt           DateTime  @default(now())
  vehicle             Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reminderAction      ReminderAction?

  @@index([vehicleId])
  @@index([expiresOn])
}

enum ReminderSourceType {
  document
  maintenance
  cost
  custom
  vehicle_itp
  maintenance_plan
}

enum MaintenancePlanTriggerMode {
  time
  km
  whichever_first
}

/// Operațiune planificată în planul de mentenanță preventivă al vehiculului.
model MaintenancePlanItem {
  id                      String                     @id @default(cuid())
  tenantId                String
  vehicleId               String
  title                   String
  category                String?
  notes                   String?
  sortOrder               Int                        @default(0)
  isActive                Boolean                    @default(true)
  intervalDays            Int?
  intervalKm              Int?
  triggerMode             MaintenancePlanTriggerMode @default(whichever_first)
  lastServiceOn           DateTime?
  lastServiceKm           Int?
  nextDueOn               DateTime?
  dueOdometerKm           Int?
  dueManualOverride       Boolean                    @default(false)
  reminderOffsetsDays     Json?
  reminderOffsetsKm       Json?
  reminderMenuSyncEnabled Boolean                    @default(true)
  preferredProvider       String?
  estimatedCostCents      Int?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  tenant                  Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle                 Vehicle                    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reminderAction          ReminderAction?

  @@index([tenantId])
  @@index([vehicleId])
  @@index([vehicleId, sortOrder])
}

enum OdometerReadingSource {
  manual
  tracking
  import
}

model OdometerReading {
  id          String                @id @default(cuid())
  vehicleId   String
  odometerKm  Int
  source      OdometerReadingSource @default(manual)
  sourceRef   String?
  notes       String?
  recordedAt  DateTime              @default(now())
  recordedByUserId String?
  vehicle     Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  recordedBy  User?                 @relation("OdometerReadingBy", fields: [recordedByUserId], references: [id])

  @@index([vehicleId, recordedAt])
}

model ReminderAction {
  id                      String             @id @default(cuid())
  tenantId                String
  vehicleId               String
  sourceType              ReminderSourceType
  title                   String
  notes                   String?
  vehicleDocumentId       String?            @unique
  maintenanceEntryId      String?            @unique
  costEntryId             String?            @unique
  vehicleItpProfileVehicleId String?         @unique
  maintenancePlanItemId   String?            @unique
  dueOn                   DateTime?
  reminderOffsetsDays     Json?
  dueOdometerKm           Int?
  reminderOffsetsKm       Json?
  intervalDays            Int?
  intervalKm              Int?
  lastPerformedOn         DateTime?
  lastPerformedOdometerKm Int?
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle                 Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  document                VehicleDocument?   @relation(fields: [vehicleDocumentId], references: [id], onDelete: Cascade)
  maintenance             MaintenanceEntry?  @relation(fields: [maintenanceEntryId], references: [id], onDelete: Cascade)
  cost                    CostEntry?         @relation(fields: [costEntryId], references: [id], onDelete: Cascade)
  vehicleItpProfile       Vehicle?           @relation("VehicleItpProfileReminder", fields: [vehicleItpProfileVehicleId], references: [id], onDelete: Cascade)
  maintenancePlan         MaintenancePlanItem? @relation(fields: [maintenancePlanItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vehicleId])
  @@index([dueOn])
  @@index([sourceType])
}

enum MembershipRole {
  tenant_admin
  tenant_viewer
}

enum VehicleType {
  car
  van_lt_3_5
  van_gt_3_5
  tractor_unit
  trailer
  semi_trailer
}

enum VehicleStatus {
  active
  inactive
  in_maintenance
  decommissioned
}
