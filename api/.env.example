# PostgreSQL (ex. după `docker compose up -d` din rădăcina monorepo-ului)
DATABASE_URL="postgresql://fleet:fleet@localhost:5432/fleet?schema=public"

PORT=4000
WEB_ORIGIN=http://localhost:3000

# Semnare JWT (login utilizatori din DB)
JWT_SECRET="schimba-cu-un-secret-lung-in-productie"

# GET /auth/me — necesită Authorization: Bearer <token>; returnează { email?, tenantSlug, role }.
# UI-ul Next folosește acest endpoint (server-side, cu JWT din cookie) ca să știe dacă ascunde acțiunile de scriere (RBAC).

# SMTP partener (PARTNER-004) — opțional; fără setare, outbox persistă + log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=notify@demo.local

# npm run auth:hash-password -- "parola-ta"

# Doar pentru teste e2e (nu seta în producție): permite tenant din header fără JWT
# ALLOW_HEADER_TENANT=true

# PDF foi de parcurs / FAZ — Google Cloud Storage (obligatoriu în producție)
# GCS_BUCKET=fleet-enterprise-trip-sheets
# Local: Application Default Credentials sau GOOGLE_APPLICATION_CREDENTIALS=/path/sa.json

# BOT populare date — implicit activ local; pe Cloud Run (NODE_ENV=production) necesită true
# BOT_ENABLED=true
